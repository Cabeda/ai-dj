{
  "name": "@ai-dj/strudel",
  "version": "0.1.0",
  "type": "module",
  "description": "Headless Strudel sound host, offline renderer and analyzer for ai-dj (line-delimited JSON on stdio)",
  "exports": {
    ".": "./prelude.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "host.ts",
    "render.ts",
    "analyze.ts",
    "prelude.ts",
    "README.md"
  ],
  "scripts": {
    "build": "bash build.sh",
    "check": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@strudel/core": "^1.2.6",
    "@strudel/mini": "^1.2.6",
    "@strudel/soundfonts": "^1.3.0",
    "@strudel/tonal": "^1.2.6",
    "@strudel/transpiler": "^1.2.6",
    "@strudel/webaudio": "^1.3.0",
    "node-web-audio-api": "^2.2.0",
    "superdough": "^1.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "^5"
  }
}
